#!/usr/bin/env bash
# external-review: run independent reviewers (other model families) over a snapshot of the repository.
# Harness-agnostic: needs only bash, git and python3.
set -u
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/lib/common.sh"
source "$ER_SKILL_DIR/bin/lib/finalize.sh"
source "$ER_SKILL_DIR/bin/lib/usage.sh"
ER_REPO="${EXTERNAL_REVIEW_REPO:-genhoi/external-review}"
PROFILE_MARK="<!-- external-review: project profile -->"
# Profile = the stable part of the brief: a "## External review" section in AGENTS.md / CLAUDE.md.
# Printed by `py profile ROOT`; source name with --source.

usage() {
  cat <<'USAGE'
review — a second opinion on code from other models

  review doctor                         which reviewers are available and what is missing
  review config [set KEY VALUE]         effective models / effort / language and the override file
  review brief [--out FILE] [--lang L]  brief template + project profile ("## External review" in AGENTS.md/CLAUDE.md)
  review run --brief FILE [options]     start reviewers in the background; prints the run directory
      --reviewers auto|glm,kimi,grok,codex,opus,kimi-cli   (auto = everyone who passes doctor)
      --mode diff|repo|plan             diff: changes against base (default)
      --base REF                        base for diff (default: merge-base with main/master)
      --plan FILE                       document for plan mode
      --lang en|ru                      language of the protocol and the report (default: REVIEW_LANG)
      --lens NAME[,NAME]                lens from prompts/<lang>/lenses (correctness, security, ops, tests)
      --blind                           strip intent and "known decisions" from the brief
      --prompt-file FILE                your own prompt instead of protocol+brief (experiments)
      --timeout SEC                     per-reviewer limit (default 2700)
      --deps copy|hardlink|symlink|none how ignored dependencies get into the snapshot (default: REVIEW_DEPS=copy)
      --link PATH                       extra dependency path to bring in (repeatable;
                                        default: vendor node_modules .venv .env .env.local .env.test)
      --effort LEVEL                    effort for the claude family (default max)
  review preflight "CMD" [--deps M]     run CMD inside a fresh snapshot (deps included) and show the result:
                                        verify the test commands from the brief BEFORE spending reviewer time
  review status [RUN]                   progress (RUN = path or name; default: latest run of this project)
  review wait [RUN] [--max SEC]         wait; returns within ≤110 s: exit 0 = all done, exit 3 = call again
  review collect [RUN]                  build merged.md (findings table × reviewer + full reports)
  review ask RUN REVIEWER "question"    continue a reviewer's session (counter-evidence, clarification)
  review feedback RUN "note"            save the orchestrator's note on this run (what helped, what blocked, accepted/rejected)
  review feedback --digest [--since D]  usage journal + notes of this machine as Markdown
  review feedback --issue [--since D]   post the digest as a GitHub issue to the skill's repository (gh)
  review logs RUN REVIEWER              stderr tail and progress
  review runs                           runs of the current project
  review clean [RUN|--all]              remove worktrees and the run directory (--all: every run and preflight of this project)
USAGE
}

lang_dir() { # lang_dir LANG
  [ -d "$ER_SKILL_DIR/prompts/$1" ] || die "unknown language '$1' (available: $(ls "$ER_SKILL_DIR/prompts" | tr '\n' ' '))"
  printf '%s' "$ER_SKILL_DIR/prompts/$1"
}

cmd_doctor() {
  local b out rc
  printf '%-9s %s\n' "REVIEWER" "STATUS"
  for b in $ER_ALL_BACKENDS; do
    out="$(bash "$ER_SKILL_DIR/bin/backends/$b.sh" check 2>&1)"; rc=$?
    printf '%-9s %s %s\n' "$b" "$([ $rc -eq 0 ] && echo '✓' || echo '✗')" "$out"
  done
}

available_backends() {
  local b
  for b in $ER_ALL_BACKENDS; do
    [ "$b" = "kimi-cli" ] && continue   # fallback path; only via --reviewers
    bash "$ER_SKILL_DIR/bin/backends/$b.sh" check >/dev/null 2>&1 && echo "$b"
  done
}

cmd_config() {
  if [ "${1:-}" = "set" ]; then
    [ $# -eq 3 ] || die "config set KEY VALUE"
    case " $ER_CONFIG_KEYS " in *" $2 "*) ;; *) die "unknown key $2; allowed: $ER_CONFIG_KEYS";; esac
    mkdir -p "$(dirname "$ER_CONFIG_FILE")"; touch "$ER_CONFIG_FILE"
    grep -vE "^\s*$2=" "$ER_CONFIG_FILE" > "$ER_CONFIG_FILE.tmp" || true
    printf '%s=%s\n' "$2" "$3" >> "$ER_CONFIG_FILE.tmp"; mv "$ER_CONFIG_FILE.tmp" "$ER_CONFIG_FILE"
    echo "written to $ER_CONFIG_FILE: $2=$3"; return
  fi
  echo "override file: $ER_CONFIG_FILE $([ -f "$ER_CONFIG_FILE" ] && echo '(exists)' || echo '(absent — skill defaults apply)')"
  echo "precedence: environment variable → file → default in bin/lib/defaults.sh"
  local k
  for k in $ER_CONFIG_KEYS; do printf '  %-16s %s\n' "$k" "${!k}"; done
  echo "change: review config set CODEX_MODEL gpt-5.7-sol   (or export CODEX_MODEL=... for one run)"
}

append_profile() { # append_profile ROOT FILE — add the project profile section (idempotent via marker)
  local root="$1" file="$2" src
  grep -qF "$PROFILE_MARK" "$file" 2>/dev/null && return 0
  src="$(py profile "$root" --source 2>/dev/null)" || return 1
  { echo; echo "## Project profile (from $src)"; echo "$PROFILE_MARK"; echo; py profile "$root"; } >> "$file"
  echo "$src"
}

cmd_brief() {
  local out="" lang="$REVIEW_LANG"
  while [ $# -gt 0 ]; do case "$1" in --out) out="$2"; shift 2;; --lang) lang="$2"; shift 2;; *) die "brief: unknown option $1";; esac; done
  local src; src="$(lang_dir "$lang")/brief.md"
  local root; root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  local tmp; tmp="$(mktemp)"; cp "$src" "$tmp"
  local from=""
  [ -z "$root" ] || from="$(append_profile "$root" "$tmp" || true)"
  [ -z "$from" ] || warn "project profile appended from $from — fill in only the per-run sections"
  if [ -n "$out" ]; then mv "$tmp" "$out"; echo "$out"; else cat "$tmp"; rm -f "$tmp"; fi
}

write_header() { # write_header RUN MODE BASE HEAD PROJ_ROOT LINKS LANG DEPS
  local run="$1" mode="$2" base="$3" head="$4" root="$5" links="$6" lang="$7" deps="$8"
  local stat; stat="$(git -C "$run/_snapshot_ref" diff --stat "$base...HEAD" 2>/dev/null | tail -n 60)"
  if [ "$lang" = "ru" ]; then
    {
      echo "# Служебная вводная (сгенерирована review run)"; echo
      echo "- Ты работаешь в одноразовом снапшоте репозитория: \`\$PWD\` (detached git worktree на коммит \`${head:0:12}\`)."
      echo "  Всё, что ты здесь меняешь, никуда не попадает. Можно запускать тесты, писать одноразовые скрипты и тесты, править код ради воспроизведения."
      echo "- Оригинальное рабочее дерево: \`$root\` — НЕ трогай его и ничего туда не пиши."
      case "$deps" in
        copy)     [ -n "$links" ] && echo "- Зависимости ($links) СКОПИРОВАНЫ в снапшот: это обычные каталоги, тесты запускай прямо здесь. Если тесты идут в docker — монтируй в контейнер ЭТОТ каталог (\`\$PWD\`), а не оригинальный репозиторий, иначе проверишь не тот код." ;;
        hardlink) [ -n "$links" ] && echo "- Зависимости ($links) — хардлинки на оригинал: НЕ редактируй их файлы на месте (это изменит оригинал). Тесты запускай здесь; в docker монтируй \`\$PWD\`." ;;
        symlink)  [ -n "$links" ] && echo "- Зависимости ($links) — симлинки в оригинал (не менять содержимое). Внутри docker-контейнера, куда смонтирован снапшот, они не разрешатся: команды тестов из вводной проверь." ;;
        none)     echo "- Игнорируемые зависимости (vendor, node_modules, .venv) в снапшот НЕ перенесены: установи их сам или запускай тесты так, как описано во вводной." ;;
      esac
      echo "- Никаких \`git push\`, коммитов в чужие ветки и сетевых действий с чужими системами."
      echo "- Режим ревью: **$mode**."
      case "$mode" in
        diff) echo "- База сравнения: \`$base\`. Ревьюишь изменения \`git diff $base...HEAD\` (снапшот включает незакоммиченные правки)."
              echo "- Затронутые файлы:"; echo '```'; echo "$stat"; echo '```'
              echo "- Код вне диффа — контекст: читай столько, сколько нужно, чтобы понять последствия изменений (вызывающие места, миграции, конфиги, тесты)." ;;
        repo) echo "- Ревью всего репозитория по приоритетам из вводной ниже." ;;
        plan) echo "- Ревью документа \`plan.md\` (лежит в корне снапшота и вложен в конец промпта). Репозиторий доступен, чтобы проверять допущения плана по реальному коду." ;;
      esac; echo
    } > "$run/header.md"
  else
    {
      echo "# Run context (generated by review run)"; echo
      echo "- You are working in a disposable snapshot of the repository: \`\$PWD\` (detached git worktree at commit \`${head:0:12}\`)."
      echo "  Nothing you change here goes anywhere. You may run tests, write throwaway scripts and tests, and modify code to reproduce a hypothesis."
      echo "- The original working tree is \`$root\` — do NOT touch it and do not write anything there."
      case "$deps" in
        copy)     [ -n "$links" ] && echo "- Dependencies ($links) are COPIED into the snapshot: real directories, run the tests right here. If the tests run in docker, mount THIS directory (\`\$PWD\`) into the container, not the original repository, or you will test the wrong code." ;;
        hardlink) [ -n "$links" ] && echo "- Dependencies ($links) are hardlinks to the original: do NOT edit their files in place (that changes the original). Run the tests here; in docker mount \`\$PWD\`." ;;
        symlink)  [ -n "$links" ] && echo "- Dependencies ($links) are symlinks into the original (do not modify their contents). Inside a docker container that mounts the snapshot they will not resolve: double-check the test commands from the brief." ;;
        none)     echo "- Ignored dependencies (vendor, node_modules, .venv) were NOT brought into the snapshot: install them yourself or run the tests as described in the brief." ;;
      esac
      echo "- No \`git push\`, no commits to other branches, no network actions against other systems."
      echo "- Review mode: **$mode**."
      case "$mode" in
        diff) echo "- Base: \`$base\`. You are reviewing \`git diff $base...HEAD\` (the snapshot includes uncommitted changes)."
              echo "- Files touched:"; echo '```'; echo "$stat"; echo '```'
              echo "- Code outside the diff is context: read as much as you need to understand the consequences (call sites, migrations, configs, tests)." ;;
        repo) echo "- Review the whole repository according to the priorities in the brief below." ;;
        plan) echo "- Review the document \`plan.md\` (in the snapshot root and appended to the end of this prompt). The repository is available to check the plan's assumptions against real code." ;;
      esac; echo
    } > "$run/header.md"
  fi
}

cmd_run() {
  local brief="" reviewers="auto" mode="diff" base="" plan="" lens="" blind="" prompt_file="" timeout="$ER_DEFAULT_TIMEOUT" effort="max" lang="$REVIEW_LANG" deps="$REVIEW_DEPS"
  local links="$ER_DEFAULT_LINKS" extra_links=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --brief) brief="$2"; shift 2;; --reviewers) reviewers="$2"; shift 2;; --mode) mode="$2"; shift 2;;
      --base) base="$2"; shift 2;; --plan) plan="$2"; shift 2;; --lens) lens="$2"; shift 2;; --lang) lang="$2"; shift 2;;
      --blind) blind=1; shift;; --prompt-file) prompt_file="$2"; shift 2;; --timeout) timeout="$2"; shift 2;;
      --link) extra_links="$extra_links $2"; shift 2;; --effort) effort="$2"; shift 2;; --deps) deps="$2"; shift 2;;
      -h|--help) usage; exit 0;; *) die "run: unknown option $1";;
    esac
  done
  [ -n "$brief" ] || [ -n "$prompt_file" ] || die "run: --brief FILE is required (template: review brief --out brief.md)"
  [ -z "$brief" ] || [ -f "$brief" ] || die "run: brief file not found: $brief"
  case "$mode" in diff|repo|plan) ;; *) die "run: --mode diff|repo|plan";; esac
  [ "$mode" != "plan" ] || [ -f "${plan:-/nonexistent}" ] || die "run: --mode plan requires --plan FILE"
  local pdir; pdir="$(lang_dir "$lang")"
  case "$deps" in copy|hardlink|symlink|none) ;; *) die "run: --deps copy|hardlink|symlink|none";; esac

  local root name run snap_commit
  root="$(proj_root)"; name="$(basename "$root")"
  mkdir -p "$ER_RUNS"
  run="$(mktemp -d "$ER_RUNS/$name-$(date +%Y%m%d-%H%M%S)-XXXX")"   # suffix: two runs in the same second must not collide
  echo "$root" > "$run/project_root"; echo "$timeout" > "$run/timeout"; echo "$lang" > "$run/lang"; echo "$deps" > "$run/deps"
  printf '%s\n' $links $extra_links > "$run/links"

  snap_commit="$(snapshot_commit "$root")"
  if [ "$mode" = "diff" ]; then
    base="$(detect_base "$root" "$base")" || die "run: no base found (main/master); pass --base REF"
    local mb; mb="$(git -C "$root" merge-base "$base" "$snap_commit")"
    [ "$mb" != "$snap_commit" ] || die "run: no changes between $base and the working tree — nothing to review (or use --mode repo)"
    base="$mb"
  fi

  make_worktree "$root" "$snap_commit" "$run/_snapshot_ref" none
  write_header "$run" "$mode" "$base" "$snap_commit" "$root" "$(echo $links $extra_links)" "$lang" "$deps"
  remove_worktree "$root" "$run/_snapshot_ref"

  local lens_args=() l
  if [ -n "$lens" ]; then
    for l in ${lens//,/ }; do
      [ -f "$pdir/lenses/$l.md" ] || die "run: lens not found: prompts/$lang/lenses/$l.md"
      lens_args+=(--lens "$pdir/lenses/$l.md")
    done
  fi
  if [ -n "$prompt_file" ]; then
    { cat "$run/header.md"; echo; cat "$prompt_file"; } > "$run/prompt.md"
  else
    cp "$brief" "$run/brief.md"
    # project profile: appended when the brief was not seeded from it (marker absent)
    local from; from="$(append_profile "$root" "$run/brief.md" || true)"
    [ -z "$from" ] || warn "project profile appended to the brief from $from"
    py assemble --header "$run/header.md" --protocol "$pdir/reviewer.md" --brief "$run/brief.md" \
      "${lens_args[@]}" ${blind:+--blind} > "$run/prompt.md"
  fi
  if [ "$mode" = "plan" ]; then
    cp "$plan" "$run/plan.md"
    { echo; echo "---"; echo; echo "# Document under review (plan.md)"; echo; cat "$plan"; } >> "$run/prompt.md"
  fi

  local list
  if [ "$reviewers" = "auto" ]; then list="$(available_backends | tr '\n' ' ')"; else list="${reviewers//,/ }"; fi
  [ -n "$list" ] || die "run: no reviewers available (review doctor)"
  python3 - "$run" "$name" "$mode" "$base" "$snap_commit" "$list" "$lang" <<'PY'
import json, sys, datetime
run, name, mode, base, snap, lst, lang = sys.argv[1:8]
json.dump({"project": name, "mode": mode, "base": base, "snapshot_commit": snap, "lang": lang,
           "reviewers": lst.split(), "started": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")},
          open(f"{run}/meta.json", "w"), ensure_ascii=False, indent=1)
PY

  local r d
  for r in $list; do
    d="$run/$r"; mkdir -p "$d"
    bash "$ER_SKILL_DIR/bin/backends/${r%%:*}.sh" format > "$d/format" 2>/dev/null || { warn "no backend $r — skipping"; rm -rf "$d"; continue; }
    make_worktree "$root" "$snap_commit" "$d/snapshot" "$deps" $links $extra_links
    [ "$mode" != "plan" ] || cp "$plan" "$d/snapshot/plan.md"
    uuid > "$d/session"
    echo queued > "$d/status"
    ER_EFFORT="$effort" setsid nohup bash "$ER_SKILL_DIR/bin/lib/launch.sh" "$run" "$r" >/dev/null 2>&1 < /dev/null &
    echo $! > "$d/pid"
  done
  echo "$run"
  usage_log run run="$(basename "$run")" mode="$mode" lang="$lang" deps="$deps" reviewers="$(echo $list | tr ' ' ',')" blind="${blind:-0}" lens="$lens" profile="$(py profile "$root" --source 2>/dev/null || echo none)" prompt_file="${prompt_file:+1}"
  local dr; dr="$(deps_report "$root" $links $extra_links)"
  [ -z "$dr" ] || echo "deps ($deps): $dr" >&2
  if [ "$deps" = copy ]; then
    local bytes; bytes=$(du -sbc $(for l in $links $extra_links; do [ -e "$root/$l" ] && echo "$root/$l"; done) 2>/dev/null | tail -n1 | cut -f1)
    [ "${bytes:-0}" -lt 1073741824 ] || echo "hint: dependencies exceed 1 GB per snapshot — consider REVIEW_DEPS=hardlink (instant; do not edit their files in place)" >&2
  fi
  echo "started: $list" >&2
  echo "progress: review status $run · wait: review wait $run · merge: review collect $run" >&2
}

cmd_preflight() {
  local cmd="" deps="$REVIEW_DEPS" timeout="${EXTERNAL_REVIEW_PREFLIGHT_TIMEOUT:-900}" links="$ER_DEFAULT_LINKS" extra_links=""
  while [ $# -gt 0 ]; do
    case "$1" in --deps) deps="$2"; shift 2;; --link) extra_links="$extra_links $2"; shift 2;; --timeout) timeout="$2"; shift 2;;
      *) [ -z "$cmd" ] || die "preflight: one command string expected (quote it)"; cmd="$1"; shift;; esac
  done
  [ -n "$cmd" ] || die 'preflight: usage: review preflight "<test command from the brief>" [--deps copy|hardlink|symlink|none]'
  local root name dir snap_commit; root="$(proj_root)"; name="$(basename "$root")"
  mkdir -p "$ER_RUNS"; dir="$(mktemp -d "$ER_RUNS/preflight-$name-XXXX")"
  snap_commit="$(snapshot_commit "$root")"
  make_worktree "$root" "$snap_commit" "$dir/snapshot" "$deps" $links $extra_links
  local dr; dr="$(deps_report "$root" $links $extra_links)"; [ -z "$dr" ] || echo "deps ($deps): $dr" >&2
  echo "snapshot: $dir/snapshot" >&2
  echo "running:  $cmd" >&2
  local t0; t0=$(date +%s)
  ( cd "$dir/snapshot" && timeout -k 30 "$timeout" bash -lc "$cmd" ) > "$dir/output" 2>&1; local code=$?
  usage_log preflight exit="$code" seconds="$(( $(date +%s) - t0 ))" deps="$deps"
  echo "--- output (last 30 lines) ---"; tail -n 30 "$dir/output"; echo "--- exit code: $code ---"
  remove_worktree "$root" "$dir/snapshot"
  if [ "$code" -eq 0 ]; then rm -rf "$dir"; echo "preflight OK — the command works inside a snapshot; the brief can say so"
  else echo "preflight FAILED — fix the command or the project profile before launching reviewers (full output: $dir/output)"; fi
  return "$code"
}

elapsed() { # elapsed DIR
  local s; s="$(cat "$1/started" 2>/dev/null)" || { echo "—"; return; }
  local e; e="$(cat "$1/finished" 2>/dev/null || now_iso)"
  local a b; a=$(date -d "$s" +%s); b=$(date -d "$e" +%s)
  printf '%dm%02ds' $(( (b-a)/60 )) $(( (b-a)%60 ))
}

# A wrapper that vanished without writing a final status (killed, or the skill was edited mid-run):
# finalize it from what is on disk — a report means "done", whatever the exit code.
reap_dead() { # reap_dead RUN
  local r d st
  for r in $(run_reviewers "$1"); do
    d="$1/$r"; st="$(status_of "$1" "$r")"
    case "$st" in queued|running) ;; *) continue;; esac
    [ -f "$d/pid" ] && kill -0 "$(cat "$d/pid")" 2>/dev/null && continue
    finalize_reviewer "$1" "$r" died
  done
}

cmd_status() {
  local run; run="$(resolve_run "${1:-}")"
  reap_dead "$run"
  echo "run: $run"
  local r d st ex
  for r in $(run_reviewers "$run"); do
    d="$run/$r"; st="$(status_of "$run" "$r")"; ex="$(cat "$d/exit" 2>/dev/null || true)"
    if [ "$st" = "done" ] && [ -n "$ex" ] && [ "$ex" != 0 ]; then st="done(exit $ex)"; fi
    printf '%-14s %-8s %s\n' "$r $st" "$(elapsed "$d")" "$(py progress "$(cat "$d/format")" "$d/raw" 2>/dev/null)"
  done
}

cmd_wait() {
  # Returns within --max seconds (default 110: under the 2-minute Bash tool timeout of Claude Code and
  # similar harnesses): exit 0 — all finished, exit 3 — still running, call again.
  local run="" interval=15 max="${EXTERNAL_REVIEW_WAIT_MAX:-110}"
  while [ $# -gt 0 ]; do case "$1" in --interval) interval="$2"; shift 2;; --max) max="$2"; shift 2;; *) run="$1"; shift;; esac; done
  run="$(resolve_run "$run")"
  local t0; t0=$(date +%s)
  while :; do
    reap_dead "$run"
    local busy="" r
    for r in $(run_reviewers "$run"); do case "$(status_of "$run" "$r")" in queued|running) busy="$busy $r";; esac; done
    if [ -z "$busy" ]; then cmd_status "$run"; echo "all reviewers finished: review collect $run"; return 0; fi
    if [ $(( $(date +%s) - t0 )) -ge "$max" ]; then
      cmd_status "$run"; echo "still running:$busy — call review wait $run again (this is the only way to wait in headless mode)"; return 3
    fi
    sleep "$interval"
  done
}

cmd_collect() {
  local run; run="$(resolve_run "${1:-}")"
  reap_dead "$run"
  py merge "$run" > "$run/merged.md"
  py summary "$run" > "$run/summary.json" 2>/dev/null || true
  usage_log collect run="$(basename "$run")" reviewers="@$run/summary.json"
  echo "$run/merged.md"
}

cmd_ask() {
  [ $# -ge 3 ] || die "ask RUN REVIEWER \"question\""
  local run; run="$(resolve_run "$1")"; local r="$2"; shift 2; local msg="$*"
  local d="$run/$r"; [ -d "$d" ] || die "no reviewer $r in this run"
  export ER_RUN="$run" ER_REVIEWER="$r" ER_DIR="$d" ER_SNAPSHOT="$d/snapshot" ER_PROMPT="$run/prompt.md"
  export ER_PROJ_ROOT="$(cat "$run/project_root")" ER_TIMEOUT="$(cat "$run/timeout")"
  local n; n=$(ls "$d"/ask-*.md 2>/dev/null | wc -l); n=$((n+1))
  usage_log ask run="$(basename "$run")" reviewer="$r" n="$n"
  { echo "## Question"; echo; echo "$msg"; echo; echo "## Answer ($r)"; echo; } > "$d/ask-$n.md"
  timeout -k 30 "$ER_TIMEOUT" bash "$ER_SKILL_DIR/bin/backends/${r%%:*}.sh" ask "$msg" 2>>"$d/stderr.log" | tee -a "$d/ask-$n.md"
}

cmd_feedback() {
  local since="" mode="note" run="" text="" file=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --digest) mode=digest; shift;; --issue) mode=issue; shift;; --since) since="$2"; shift 2;; --file) file="$2"; shift 2;;
      *) if [ -z "$run" ]; then run="$1"; else text="$1"; fi; shift;;
    esac
  done
  case "$mode" in
    digest) py digest "$ER_HOME" ${since:+--since "$since"};;
    issue)
      command -v gh >/dev/null || die "feedback --issue needs the gh CLI; run: review feedback --digest and paste it into https://github.com/$ER_REPO/issues"
      local body; body="$(mktemp)"; py digest "$ER_HOME" ${since:+--since "$since"} > "$body"
      gh issue create -R "$ER_REPO" --title "Field feedback: $(hostname) $(date +%Y-%m-%d)" --body-file "$body" --label feedback 2>/dev/null \
        || gh issue create -R "$ER_REPO" --title "Field feedback: $(hostname) $(date +%Y-%m-%d)" --body-file "$body"
      rm -f "$body";;
    note)
      [ -n "$run" ] || die 'feedback: usage: review feedback RUN "note" | --file FILE | --digest | --issue'
      run="$(resolve_run "$run")"
      [ -n "$file" ] && text="$(cat "$file")"
      [ -n "$text" ] || die "feedback: the note is empty"
      printf '%s\n' "$text" > "$run/feedback.md"
      python3 - "$ER_HOME/feedback.jsonl" "$(basename "$run")" "$(proj_name)" "$(usage_harness)" "$run/feedback.md" <<'PY'
import json, sys, datetime
path, run, project, harness, note = sys.argv[1:6]
rec = {"ts": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"), "run": run,
       "project": project, "harness": harness, "note": open(note, encoding="utf-8").read().strip()}
with open(path, "a", encoding="utf-8") as fh: fh.write(json.dumps(rec, ensure_ascii=False) + "\n")
PY
      usage_log feedback run="$(basename "$run")" chars="$(wc -c < "$run/feedback.md")"
      echo "saved: $run/feedback.md (and $ER_HOME/feedback.jsonl) — share with: review feedback --issue";;
  esac
}

cmd_logs() {
  local run; run="$(resolve_run "$1")"; local d="$run/$2"
  echo "--- stderr (tail) ---"; tail -n 30 "$d/stderr.log" 2>/dev/null
  echo "--- progress ---"; py progress "$(cat "$d/format")" "$d/raw"
}

cmd_runs() { ls -1d "$ER_RUNS/$(proj_name)"-* 2>/dev/null || echo "no runs"; }

cmd_clean() {
  local root; root="$(proj_root)"
  local targets=()
  if [ "${1:-}" = "--all" ]; then mapfile -t targets < <(ls -1d "$ER_RUNS/$(basename "$root")"-* "$ER_RUNS/preflight-$(basename "$root")"-* 2>/dev/null)
  else targets=("$(resolve_run "${1:-}")"); fi
  local run r
  for run in "${targets[@]}"; do
    for r in $(run_reviewers "$run"); do
      [ -f "$run/$r/pid" ] && kill "$(cat "$run/$r/pid")" 2>/dev/null
      remove_worktree "$root" "$run/$r/snapshot"
    done
    [ ! -d "$run/snapshot" ] || remove_worktree "$root" "$run/snapshot"   # preflight dir
    rm -rf "$run"; echo "removed $run"; usage_log clean run="$(basename "$run")"
  done
  git -C "$root" worktree prune 2>/dev/null || true
}

case "${1:-}" in
  doctor) shift; cmd_doctor "$@";;
  config) shift; cmd_config "$@";;
  brief) shift; cmd_brief "$@";;
  run) shift; cmd_run "$@";;
  preflight) shift; cmd_preflight "$@";;
  status) shift; cmd_status "$@";;
  wait) shift; cmd_wait "$@";;
  collect) shift; cmd_collect "$@";;
  ask) shift; cmd_ask "$@";;
  feedback) shift; cmd_feedback "$@";;
  logs) shift; cmd_logs "$@";;
  runs) shift; cmd_runs "$@";;
  clean) shift; cmd_clean "$@";;
  -h|--help|help|"") usage;;
  *) die "unknown command: $1 (review --help)";;
esac
exit $?
